<Page
    x:Class="Light.Pages.LightStartPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Light.Pages"
    xmlns:db="using:Light.LightChatsRequests"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Hello in Light telegram client))"
                   FontSize="42"
                   Margin="10,10,10,0"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Center"/>

        <ListBox Grid.Row="1"
                 Margin="0,10,0,0"
                 ItemsSource="{x:Bind Chats}"
                 HorizontalContentAlignment="Stretch"
                 HorizontalAlignment="Stretch"
                 VerticalAlignment="Stretch">

            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="HorizontalAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0"/>
                </Style>
            </ListBox.ItemContainerStyle>

            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="db:DebugChatDto">
                    <Grid Margin="10,0,0,0"
                          Height="75"
                          HorizontalAlignment="Stretch">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Image Grid.Column="0"
                               Grid.Row="0"
                               Grid.RowSpan="2"
                               Width="55"
                               Height="55"
                               Margin="0,0,10,0"
                               Source="../Assets/icons8-изображение-96.png"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               Stretch="UniformToFill"/>

                        <TextBlock Grid.Column="1"
                                   Grid.Row="0"
                                   Text="{x:Bind Name}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,0,5,0"/>

                        <TextBlock Grid.Column="2"
                                   Grid.Row="0"
                                   Text="{x:Bind LastMessageTime}"
                                   FontSize="12"
                                   Foreground="Gray"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right"
                                   Margin="0,0,25,0"/> 

                        <TextBlock Grid.Column="1"
                                   Grid.Row="1"
                                   Text="{x:Bind ContentPreview}"
                                   FontSize="14"
                                   Foreground="LightGray"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,0,10,0"/>

                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Page>
