<Page
    x:Class="Light.Pages.AuthorizationRootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Light.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="14*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Center"
                   Margin="10,0"
                   Text="Authorization page"
                   FontSize="18"/>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Visibility="Visible">

            <Button HorizontalAlignment="Center"
                    Margin="10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Margin="10,0"
                               Text="Authorize by @mail"
                               FontSize="18"/>
                    <Image Source="../Assets/icons8-SendApproveLight-96.png" 
                           Height="50"
                           Width="50"/>
                </StackPanel>
            </Button>

            <Button HorizontalAlignment="Center"
                    Margin="10" 
                    Command="{Binding SelectPhoneNumberAuthorizationCommand}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Margin="10,0"
                               Text="Authorize by phone number"
                               FontSize="18"/>
                    <Image Source="../Assets/icons8-SendApproveLight-96.png" 
                           Height="50"
                           Width="50"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Page>
