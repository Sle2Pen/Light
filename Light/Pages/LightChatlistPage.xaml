<Page
    x:Class="Light.Pages.LightChatlistPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:db="using:LightApplication.CachedDataRepositories"
    xmlns:tmp="using:LightApplication.LightChatsRequests"
    xmlns:tmpPreview="using:Light.LightChatsRequests"
    xmlns:converters="using:Light.ValueConverters"
    xmlns:selectors="using:Light.DataTemplateSelectors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    
    <Page.Resources>
        <converters:AvatarConverter x:Key="AvatarConverter"/>
        <converters:MessageTimeConverter x:Key="MessageTimeConverter"/>
        <converters:MessageStateVisibilityConverter x:Key="MessageStateVisibilityConverter"/>
        <!--<converters:MiniatureBitmapConverter x:Key="MiniatureBitmapConverter"/>-->

        <selectors:MessagePreviewSelector x:Key="MessagePreviewSelector"
                                          TextTemplate="{StaticResource TextMessagePreview}"
                                          PhotoTemplate="{StaticResource PhotoMessagePreview}"
                                          DocumentTemplate="{StaticResource DocumentMessagePreview}"
                                          UnknownTemplate="{StaticResource UnknownMessagePreview}" />
        
        <DataTemplate x:Key="TextMessagePreview" 
                      x:DataType="tmp:TextContent">
            <TextBlock Text="{x:Bind Text}"
                       FontSize="14"
                       Foreground="LightGray"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>
        </DataTemplate>

        <DataTemplate x:Key="PhotoMessagePreview" 
                      x:DataType="tmp:PhotoContent">
            <StackPanel Orientation="Horizontal">
                <Rectangle Height="15"
                           Width="15"
                           Fill="AliceBlue"
                           Margin="0,0,10,0"/>
                <!--<Image Source="{Binding Miniature,Converter={StaticResource MiniatureBitmapConverter}}"
                       Height="15"
                       Width="15"
                       Margin="0,0,10,0"/>-->
                
                <TextBlock Text="{x:Bind Caption.Text}"
                       FontSize="14"
                       Foreground="LightGray"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="DocumentMessagePreview" 
                      x:DataType="tmp:DocumentContent">
            <StackPanel Orientation="Horizontal">
                <Rectangle Height="15"
                           Width="15"
                           Fill="AliceBlue"
                           Margin="0,0,10,0"/>
                <!--<Image Source="{Binding Miniature,Converter={StaticResource MiniatureBitmapConverter}}"
                       Height="15"
                       Width="15"
                       Margin="0,0,10,0"/>-->

                <TextBlock Text="{x:Bind Caption.Text}"
                       FontSize="14"
                       Foreground="LightGray"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="UnknownMessagePreview" 
                      x:DataType="tmp:UnknownStringContent">
            <TextBlock Text="{x:Bind UnknownContent}"
                       FontSize="14"
                       Foreground="LightGray"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>
        </DataTemplate>

        
    </Page.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Hello in Light telegram client))"
                   FontSize="42"
                   Margin="10,10,10,0"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Center"/>

        <ListBox Grid.Row="1"
                 Margin="0,10,0,0"
                 ItemsSource="{Binding Chatlist}"
                 HorizontalContentAlignment="Stretch"
                 HorizontalAlignment="Stretch"
                 VerticalAlignment="Stretch">

            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="HorizontalAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0"/>
                </Style>
            </ListBox.ItemContainerStyle>

            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="db:ChatPreviewPresentation">
                    <Grid Margin="10,0,0,0"
                          Height="75"
                          HorizontalAlignment="Stretch">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
<!--вот те и фота с рамкой, uwp просто отстой по сравнению с wpf-->

                        <Rectangle Grid.Column="0"
                                    Grid.Row="0"
                                    Grid.RowSpan="2"
                                   Width="50"
                                    Height="50"
                                   Margin="0,0,15,0"
                                   Stroke="GhostWhite"
                                   StrokeThickness="1"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center">
                            <Rectangle.Fill>
                                <ImageBrush ImageSource="{Binding PhotoPath, Converter={StaticResource AvatarConverter}}"
                                            Stretch="UniformToFill"/>
                            </Rectangle.Fill>
                        </Rectangle>

                        <TextBlock Grid.Column="1"
                                   Grid.Row="0"
                                   Text="{Binding Title}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>

                        <Image Grid.Column="2"
                                   Grid.Row="0"
                                   Width="23"
                                   Height="23"
                               Source="../Assets/icons8-double-tick-96.png"
                                    Visibility="{Binding IsOutgoingMessage,Converter={StaticResource MessageStateVisibilityConverter}}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right"/>

                        <TextBlock Grid.Column="3"
                                   Grid.Row="0"
                                   Text="{Binding MessagePreview.Date,Converter={StaticResource MessageTimeConverter}}"
                                   FontSize="12"
                                   Foreground="Gray"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right"
                                   Margin="0,0,15,0"/>

                        <!--<local:TypeBasedContentPresenter Grid.Column="1"
                                                        Grid.ColumnSpan="2"
                                                        Grid.Row="1"
                                                        Margin="0,0,10,0"
                                                         Content="{x:Bind MessagePreview.PreviewContent, Mode=OneWay}"
                                                         ContentTemplateSelector="{StaticResource MessageContentSelector}" />-->

                        <ContentControl Grid.Column="1"
                                        Grid.ColumnSpan="2"
                                        Grid.Row="1"
                                        Margin="0,0,10,0"
                                        Content="{x:Bind MessagePreview.PreviewContent}"
                                        ContentTemplateSelector="{StaticResource MessagePreviewSelector}"/>



                        <Grid x:Name="ReactionsAndMensionsPanel"
                            Grid.Column="3"
                                   Grid.Row="1"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right"
                                   Margin="15,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Rectangle Grid.Column="2"
                                Fill="#378df0" 
                                   Width="20" 
                                   Height="20"
                                    HorizontalAlignment="Right"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding UnreadCount}"
                                       FontSize="12"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                            
                            <Image Grid.Column="1"
                               Width="20"
                               Height="20"
                               Source="../Assets/icons8-сердце-96-light.png"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               Stretch="UniformToFill"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding UnreadReactionCount}"
                                       FontSize="12"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                            
                            <Rectangle Grid.Column="0"
                                Fill="#378df0" 
                                   Width="20" 
                                   Height="20" 
                                    HorizontalAlignment="Right"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="0"
                                       Text="{Binding UnreadMentionCount}"
                                       FontSize="12"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Page>
