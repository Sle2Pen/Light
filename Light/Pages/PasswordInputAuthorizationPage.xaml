<Page
    x:Class="Light.Pages.PasswordInputAuthorizationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Light.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <StackPanel Orientation="Vertical"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Visibility="Visible">

        <TextBlock HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Margin="10"
                               Text="{Binding PasswordHint}"
                               FontSize="18"/>

        <TextBlock HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Margin="10"
                               Text="Enter password"
                               FontSize="18"/>

        <PasswordBox x:Name="AuthorizationCode"
            HorizontalAlignment="Left"
                               VerticalAlignment="Stretch"
                               Margin="10,0"
                               PlaceholderText="Type your password here..."
                               Password="{Binding InputString, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                               FontSize="18"/>

        <Button HorizontalAlignment="Center"
                    Margin="10" 
                    Command="{Binding SendCommand}">
            <StackPanel Orientation="Horizontal">
                <TextBlock HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Margin="10,0"
                               Text="Send password"
                               FontSize="18"/>
                <Image Source="../Assets/icons8-SendApproveLight-96.png" 
                           Height="50"
                           Width="50"/>
            </StackPanel>
        </Button>
    </StackPanel>
</Page>
